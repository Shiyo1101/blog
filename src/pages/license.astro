---
import { BookOpen } from "pixelarticons/react";

import PageContainer from "@/components/layout/PageContainer.astro";
import { buttonVariants } from "@/components/ui/Button";
import { RetroWindow } from "@/components/ui/RetroWindow";
import Typewriter from "@/components/ui/Typewriter";
import BaseLayout from "@/layouts/BaseLayout.astro";

const linkClass =
  "font-medium text-link underline underline-offset-4 hover:decoration-2";
---

<BaseLayout title="ライセンス情報">
  <PageContainer>
    <div class="mx-auto max-w-4xl space-y-10">
      <Typewriter
        client:load
        as="h1"
        className="h-10 font-ichigojam text-3xl text-foreground-strong md:h-12 md:text-4xl"
        texts={["License Information"]}
        delay={500}
      />

      <RetroWindow title="本サイトのライセンス" bodyClassName="space-y-4">
        <div class="bg-muted p-4">
          <p class="text-sm leading-relaxed">
            本ブログの記事や写真は「
            <strong>Creative Commons — CC BY 4.0</strong>」の下に提供します。
          </p>
          <p class="mt-2 text-sm leading-relaxed">
            記事内で紹介するプログラムや作品は、それぞれに記載されたライセンスを参照ください。
          </p>
        </div>

        <div class="border-l-4 border-border-default py-1 pl-4">
          <p class="text-sm font-bold text-foreground-strong">
            CC BY 内田吉紀 - Yoshiki Uchida
          </p>
          <p class="mt-1 text-sm text-muted-foreground">
            あなたは適切なクレジットを表示し、ライセンスへのリンクを提供し、変更があったらその旨を示す限り、
            素材を自由に共有・翻案できます。
          </p>
        </div>

        <div class="pt-2 text-center">
          <a
            href="https://creativecommons.org/licenses/by/4.0/deed.ja"
            target="_blank"
            rel="noopener noreferrer"
            class={buttonVariants()}
          >
            <BookOpen aria-hidden="true" />
            CC BY 4.0の詳細を見る
          </a>
        </div>
      </RetroWindow>

      <RetroWindow title="使用フォント">
        <div class="bg-muted p-4">
          <h3 class="mb-2 font-ichigojam text-lg text-foreground-strong">
            IchigoJam FONT TrueType
          </h3>
          <p class="text-sm leading-relaxed">
            CC BY ライセンスで提供されているフォントです。
          </p>
          <p class="mt-3 text-sm text-muted-foreground">
            提供元:
            <a
              href="https://ichigojam.net/"
              target="_blank"
              rel="noopener noreferrer"
              class:list={["ml-1", linkClass]}
            >
              IchigoJam
            </a>
            /
            <a
              href="https://15jamrecipe.jimdofree.com/"
              target="_blank"
              rel="noopener noreferrer"
              class={linkClass}
            >
              🎈 BALLOON | FU-SEN
            </a>
          </p>
        </div>
      </RetroWindow>

      <RetroWindow title="その他のクレジット" bodyClassName="space-y-4">
        <div class="bg-muted p-4">
          <h3 class="mb-2 font-bold text-foreground-strong">使用技術</h3>
          <ul class="list-inside list-disc space-y-1 text-sm">
            <li>Astro - Static Site Generator</li>
            <li>React - UI Components</li>
            <li>Tailwind CSS - Styling</li>
            <li>TypeScript - Type Safety</li>
          </ul>
        </div>

        <div class="space-y-1 bg-muted p-4">
          <h3 class="mb-2 font-bold text-foreground-strong">アイコン</h3>
          <p class="text-sm">
            <a
              href="https://github.com/halfmage/pixelarticons"
              target="_blank"
              rel="noopener noreferrer"
              class={linkClass}
            >
              pixelarticons - MIT License
            </a>
          </p>
        </div>
      </RetroWindow>

      <RetroWindow title="ご利用にあたって">
        <ul class="list-inside list-disc space-y-2 text-sm">
          <li>
            本サイトのコンテンツを利用する際は、適切なクレジット表記をお願いします
          </li>
          <li>
            商用利用も可能ですが、内容の正確性については保証いたしかねます
          </li>
          <li>プログラムコードは特に記載がない限り、自由に利用可能です</li>
          <li>
            外部リンク先のコンテンツについては、それぞれのサイトの規約に従ってください
          </li>
        </ul>
      </RetroWindow>
    </div>
  </PageContainer>
</BaseLayout>
