---
import { getCollection } from "astro:content";

import BlogCard from "@/components/Blog/BlogCard.astro";
import BlogCardWrapper from "@/components/Blog/BlogCardWrapper.astro";
import TagSearchBar from "@/components/Blog/TagSearchBar.astro";
import PageContainer from "@/components/layout/PageContainer.astro";
import Typewriter from "@/components/ui/Typewriter";
import BaseLayout from "@/layouts/BaseLayout.astro";

const DESCRIPTION = "すべてのブログ記事一覧です。";

// 下書きを除外してすべてのブログ記事を取得
const allPosts = await getCollection("blog", ({ data }) => data.draft !== true);

// 日付の新しい順にソート
const sortedPosts = allPosts.toSorted(
  (a, b) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf(),
);
---

<BaseLayout title="ブログ" description={DESCRIPTION}>
  <PageContainer>
    <div class="mb-8 space-y-3" transition:name="blog-list-header">
      <Typewriter
        client:load
        as="h1"
        className="h-10 font-ichigojam text-3xl text-foreground-strong md:h-12 md:text-4xl"
        texts={["Blog List"]}
        delay={500}
      />
      <p class="text-lg">{DESCRIPTION}</p>
    </div>
    <div class="mb-10" transition:name="blog-tag-search">
      <TagSearchBar />
    </div>
    <div transition:name="blog-list-content">
      <BlogCardWrapper>
        {sortedPosts.map((post, index) => (
          <BlogCard post={post} isPriority={index === 0} />
        ))}
      </BlogCardWrapper>
    </div>
  </PageContainer>
</BaseLayout>
