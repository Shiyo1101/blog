---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import { tagVariants } from "@/components/ui/tag";
import { formatDate } from "@/lib/utils";

type Props = {
  post: CollectionEntry<"blog">;
  /** 最初に表示されるカードか。画像を優先して読み込む */
  isPriority?: boolean;
};

/** カードに表示するタグの最大数 */
const MAX_TAGS = 2;
/** カード画像として書き出す幅（px） */
const CARD_IMAGE_WIDTHS = [320, 480, 640];
/** PostGrid の列数（1 / 2 / 3 列）に合わせた画像の表示幅 */
const CARD_IMAGE_SIZES =
  "(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw";

const { post, isPriority = false } = Astro.props;
---

<article
  class="group relative flex flex-col border-2 border-border bg-card shadow-pixel-md transition-[translate,box-shadow] duration-150 ease-pixel focus-within:shadow-focus hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-pixel-lg motion-reduce:transition-none"
  transition:name={`blog-card-${post.id}`}
>
  <div class="aspect-video overflow-hidden border-b-2 border-border bg-inset">
    <Image
      class="h-full w-full object-cover"
      src={post.data.topImage}
      alt=""
      width={640}
      height={360}
      widths={CARD_IMAGE_WIDTHS}
      sizes={CARD_IMAGE_SIZES}
      priority={isPriority}
      transition:name={`blog-image-${post.id}`}
    />
  </div>
  <div class="flex flex-1 flex-col gap-3 p-4">
    <time
      datetime={post.data.pubDate.toISOString()}
      class="text-sm text-muted-foreground"
    >
      {formatDate(post.data.pubDate)}
    </time>
    <h2
      class="font-display text-xl text-foreground-strong"
      transition:name={`blog-title-${post.id}`}
    >
      {/* カード全体をクリックできるよう、リンクの範囲をカードいっぱいに広げる */}
      <a
        href={`/blog/${post.id}`}
        class="outline-none group-hover:text-link group-hover:underline group-hover:underline-offset-4 after:absolute after:inset-0"
        data-astro-prefetch="hover"
      >
        {post.data.title}
      </a>
    </h2>
    <p class="text-sm text-muted-foreground">{post.data.description}</p>
    {post.data.tags && post.data.tags.length > 0 && (
      <ul aria-label="タグ" class="mt-auto flex flex-wrap gap-2 pt-1">
        {post.data.tags.slice(0, MAX_TAGS).map((tag) => (
          <li class={tagVariants()}>#{tag}</li>
        ))}
      </ul>
    )}
  </div>
</article>
