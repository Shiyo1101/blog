---
import { IchigoScreen } from "@/components/ichigojam/IchigoScreen";
import { buttonVariants } from "@/components/ui/Button";
import Typewriter from "@/components/ui/Typewriter";
import { SITE_DESCRIPTION } from "@/lib/site";

/** トップページのエミュレータを起動したときに実行するコマンド */
const STARTUP_COMMAND = 'PRINT "HELLO,WORLD!"';
---

<div class="container mx-auto grid grid-cols-1 items-center gap-10 px-4 py-12 sm:px-10 lg:grid-cols-2 lg:py-20">
  <div class="space-y-6">
    <Typewriter
      client:load
      as="h1"
      className="font-ichigojam text-3xl leading-snug text-foreground-strong md:text-4xl lg:text-5xl"
      texts={["Welcome to Uchii's BLOG"]}
      cursorVisible
      delay={1000}
    />
    <p class="text-lg leading-relaxed">{SITE_DESCRIPTION}</p>
    <a href="/blog" class={buttonVariants()}>
      記事を読む ▶
    </a>
  </div>
  <IchigoScreen
    client:visible
    label="IchigoJam のエミュレータ"
    startupCommand={STARTUP_COMMAND}
  />
</div>
