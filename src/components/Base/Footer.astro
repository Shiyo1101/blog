---
import { Heart } from "pixelarticons/react";

import { IJTypography } from "@/components/ui/ichigojam";

const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t-4 border-border bg-muted">
  <div class="container mx-auto px-4 py-10 sm:px-10">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      <div class="space-y-3">
        <h3 class="text-base text-foreground-strong">
          <IJTypography>ABOUT THIS SITE</IJTypography>
        </h3>
        <p class="text-sm text-muted-foreground">
          技術的な知見や日々の学びを共有するブログです。
        </p>
      </div>

      <div class="space-y-3">
        <h3 class="text-base text-foreground-strong">
          <IJTypography>NAVIGATION</IJTypography>
        </h3>
        <nav aria-label="フッターナビゲーション">
          <ul class="space-y-2 text-sm">
            <li>
              <a
                href="/"
                class="text-link underline underline-offset-4 hover:decoration-2"
              >
                ホーム
              </a>
            </li>
            <li>
              <a
                href="/blog"
                class="text-link underline underline-offset-4 hover:decoration-2"
              >
                ブログ一覧
              </a>
            </li>
            <li>
              <a
                href="/license"
                class="text-link underline underline-offset-4 hover:decoration-2"
              >
                ライセンス情報
              </a>
            </li>
          </ul>
        </nav>
      </div>

      <div class="space-y-3">
        <h3 class="text-base text-foreground-strong">
          <IJTypography>CREDITS</IJTypography>
        </h3>
        <div class="space-y-2 text-sm text-muted-foreground">
          <p>
            IchigoJam FONT TrueType by{" "}
            <a
              href="https://ichigojam.net/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-link underline underline-offset-4 hover:decoration-2"
            >
              IchigoJam
            </a>
            {" / "}
            <a
              href="https://15jamrecipe.jimdofree.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-link underline underline-offset-4 hover:decoration-2"
            >
              🎈 BALLOON | FU-SEN
            </a>
          </p>
        </div>
      </div>
    </div>

    <div class="mt-10 border-t-2 border-border-subtle pt-6 text-center text-sm text-muted-foreground">
      <div class="flex flex-col items-center justify-center gap-2 sm:flex-row">
        <span class="flex items-center gap-1">
          Made with
          <Heart
            className="size-6 text-destructive"
            role="img"
            aria-label="love"
          />
          by Yoshiki Uchida
        </span>
        <span class="hidden sm:inline">•</span>
        <span>©{currentYear}All rights reserved</span>
      </div>
      <div class="mt-2">
        <span>
          本サイトのコンテンツは
          <a
            href="https://creativecommons.org/licenses/by/4.0/deed.ja"
            target="_blank"
            rel="license noopener noreferrer"
            class="text-link underline underline-offset-4 hover:decoration-2"
          >
            CC BY 4.0
          </a>
          のもとで提供されています（
          <a
            href="/license"
            class="text-link underline underline-offset-4 hover:decoration-2"
          >
            詳細
          </a>
          ）
        </span>
      </div>
    </div>
  </div>
</footer>
