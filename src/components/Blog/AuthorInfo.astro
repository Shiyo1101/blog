---
import { BookOpen } from "pixelarticons/react";

import { IJCharacter } from "@/components/ui/ichigojam";
import { RetroWindow } from "@/components/ui/retro-window";
import { tagVariants } from "@/components/ui/tag";
import { IJCharacterCodes } from "@/lib/ichigojam/characters";

const SKILLS = ["⭐ IchigoJam検定1級", "📚 技術書執筆"];
---

<RetroWindow title="ABOUT THE AUTHOR" className="not-prose">
  <div class="flex flex-col gap-5 sm:flex-row">
    <div class="mx-auto flex size-24 shrink-0 items-center justify-center border-2 border-border bg-screen text-screen-foreground sm:mx-0">
      <IJCharacter className="text-5xl" characterCodes={IJCharacterCodes.Cat} />
    </div>
    <div class="min-w-0 flex-1 space-y-2">
      <p class="font-display text-xl text-foreground-strong">
        うっちー（Yoshiki Uchida）
      </p>
      <p class="text-sm leading-relaxed">
        福井県鯖江市に生まれたWebエンジニア。
        高校生の時に子供向けパソコンであるIchigoJamで
        プログラミングを初めて学ぶ。 趣味はツーリングとゲーム。
      </p>
      <ul class="flex flex-wrap gap-2 pt-1">
        {SKILLS.map((skill) => (
          <li class={tagVariants()}>{skill}</li>
        ))}
      </ul>
    </div>
  </div>
  <div class="mt-5 space-y-1.5 bg-muted p-3">
    <p class="flex items-center gap-1.5 font-display text-sm text-muted-foreground">
      <BookOpen className="size-6" aria-hidden="true" />
      書籍
    </p>
    <p class="text-foreground-strong">
      「FOR文と配列にチャレンジする
      <br class="sm:hidden" />
      Hana道場式プログラミング」
    </p>
    <a
      href="https://hanadojo.official.ec/items/90694010"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block text-sm font-medium text-link underline underline-offset-4 hover:decoration-2"
    >
      → 購入はこちらから
    </a>
  </div>
</RetroWindow>
