---
import { BookOpenTextIcon } from "lucide-react";

import { IJCharacter } from "@/components/ui/ichigojam";
import { IJCharacterCodes } from "@/lib/constants";
---

<div class="not-prose border-4 border-card-foreground bg-card sm:shadow-[4px_4px_0_0]">
  <div class="mb-4 border-b-4 border-card-foreground bg-accent px-3 py-1">
    <IJCharacter
      as="h3"
      className="text-xs text-accent-foreground"
      characterCodes="ABOUT THE AUTHOR"
    />
  </div>

  <div class="px-4 pb-4">
    <div class="flex flex-col gap-4 sm:flex-row">
      <div class="mx-auto shrink-0 sm:mx-0">
        <div class="flex h-24 w-24 items-center justify-center border-4 border-primary bg-primary/20 sm:h-32 sm:w-32">
          <IJCharacter
            className="text-5xl sm:text-6xl"
            characterCodes={IJCharacterCodes.Cat}
          />
        </div>
      </div>

      <div class="flex-1 space-y-3">
        <div class="border-2 border-card-foreground bg-background p-2">
          <div class="text-base font-bold sm:text-lg">
            うっちー（Yoshiki Uchida）
          </div>
        </div>

        <div class="border-2 border-card-foreground bg-background p-2">
          <p class="mt-1 text-xs leading-relaxed sm:text-sm">
            福井県鯖江市に生まれたWebエンジニア。
            高校生の時に子供向けパソコンであるIchigoJamで
            プログラミングを初めて学ぶ。 趣味はツーリングとゲーム。
          </p>
        </div>

        <div class="flex flex-wrap gap-2">
          <span class="inline-block border-2 border-primary bg-primary px-2 py-1 text-xs text-primary-foreground shadow-[2px_2px_0_0] shadow-primary/50">
            ⭐ IchigoJam検定1級
          </span>
          <span class="inline-block border-2 border-secondary bg-secondary px-2 py-1 text-xs text-secondary-foreground shadow-[2px_2px_0_0] shadow-secondary/50">
            📚 技術書執筆
          </span>
        </div>

        <div class="border-2 border-accent bg-accent/10 p-2">
          <div class="mb-1 flex items-center gap-1 text-xs font-bold text-accent sm:text-sm">
            <BookOpenTextIcon size={16} />
            <span>書籍</span>
          </div>
          <p class="text-xs font-bold sm:text-sm">
            「FOR文と配列にチャレンジする
            <br class="sm:hidden" />
            Hana道場式プログラミング」
          </p>
          <a
            href="https://hanadojo.official.ec/items/90694010"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 inline-block text-xs text-primary hover:text-primary/80 max-md:underline md:hover:underline"
          >
            → 購入はこちらから
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
