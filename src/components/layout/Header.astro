---
import { IJTypography } from "@/components/ichigojam/IchigoJamText";
import HideOnScrollHeader from "@/components/layout/HideOnScrollHeader.astro";
import { ThemeToggle } from "@/components/layout/ThemeToggle";

const { pathname } = Astro.url;

const navItems = [
  { href: "/", label: "Home", isCurrent: pathname === "/" },
  { href: "/blog", label: "Blog", isCurrent: pathname.startsWith("/blog") },
];
---

<HideOnScrollHeader>
  <div class="flex flex-wrap items-center gap-x-8 gap-y-1">
    <a
      href="/"
      class="flex items-center gap-2.5 font-display text-xl text-foreground-strong outline-offset-4"
    >
      <span
        aria-hidden="true"
        class="size-4 border-2 border-border bg-primary sm:size-5"
      ></span>
      Uchii's BLOG
    </a>
    <nav aria-label="メインナビゲーション">
      <ul class="flex items-center gap-4">
        {navItems.map(({ href, label, isCurrent }) => (
          <li>
            <a
              href={href}
              aria-current={isCurrent ? "page" : undefined}
              class="block px-2 py-1 text-foreground transition-colors duration-150 hover:bg-accent aria-[current=page]:text-foreground-strong"
            >
              <IJTypography addCursor={isCurrent}>{label}</IJTypography>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <ThemeToggle client:idle />
</HideOnScrollHeader>
