---
import "@/styles/global.css";
import { SEO } from "astro-seo";
import { ClientRouter } from "astro:transitions";

import Footer from "@/components/Base/Footer.astro";
import Header from "@/components/Base/Header.astro";
import JsonLd from "@/components/SEO/JsonLd.astro";
import ClickShatterBlock from "@/components/ui/click-shatter-block";
import { SITE_DESCRIPTION } from "@/lib/constants";

export type Props = {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
};

const {
  title = "うっちーのブログ - Uchii's Blog",
  description = SITE_DESCRIPTION,
  image = "/ogp.png",
  canonical,
} = Astro.props as Props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).href;
const fullImageUrl = new URL(image, Astro.site).href;
---

<html lang="ja" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- IchigoJamフォントのプリロード -->
    <link
      rel="preload"
      href="/fonts/IchigoJam-1.4.woff"
      as="font"
      type="font/woff"
      crossorigin="anonymous"
    />

    <script is:inline>
      function getThemePreference() {
        const storedTheme =
          typeof localStorage === "undefined"
            ? null
            : localStorage.getItem("theme");
        if (storedTheme !== null) {
          return storedTheme;
        }
        return globalThis.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "theme-light";
      }

      function setDarkMode(document) {
        const isDark = getThemePreference() === "dark";
        document.documentElement.classList.toggle("dark", isDark);

        if (typeof localStorage !== "undefined") {
          const observer = new MutationObserver(() => {
            const isDarkNow =
              document.documentElement.classList.contains("dark");
            localStorage.setItem("theme", isDarkNow ? "dark" : "theme-light");
          });
          observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class"],
          });
        }
      }

      /* ViewTransition導入後にDark modeが正常動作しなくなる問題の修正。参考：https://github.com/shadcn-ui/ui/discussions/3528 */
      setDarkMode(document);

      document.addEventListener("astro:before-swap", (ev) => {
        // Pass the incoming document to set the theme on it
        setDarkMode(ev.newDocument);
      });
      /* ************************* */
    </script>

    <SEO
      title={title}
      description={description}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          type: "website",
          url: canonicalURL,
          title: title,
          image: fullImageUrl,
        },
        optional: {
          description: description,
          siteName: "うっちーのブログ - Uchii's Blog",
          locale: "ja_JP",
        },
        image: {
          alt: "Uchii's Blog | うっちーのブログ",
        },
      }}
      twitter={{
        card: "summary_large_image",
        creator: "@yoshiki_uchida",
        title: title,
        description: description,
        image: fullImageUrl,
        imageAlt: "Uchii's Blog | うっちーのブログ",
      }}
    />

    <JsonLd
      schema={{
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "うっちーのブログ - Uchii's Blog",
        description: description,
        url: canonicalURL,
        author: {
          "@type": "Person",
          name: "うっちー (Uchii)",
          url: "https://uchii-blog.netlify.app",
        },
        inLanguage: "ja",
      }}
    />

    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <ClickShatterBlock client:load>
      <Header transition:persist />
      <main transition:animate="fade">
        <slot />
      </main>
      <Footer />
    </ClickShatterBlock>
  </body>
</html>

<style>
  /* アクセシビリティ: モーション設定を尊重 */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>
