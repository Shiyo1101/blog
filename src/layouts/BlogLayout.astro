---
import { Image } from "astro:assets";
import { type CollectionEntry, render } from "astro:content";
import { Calendar, Clock } from "pixelarticons/react";

import AuthorInfo from "@/components/blog/AuthorInfo.astro";
import Breadcrumb from "@/components/blog/Breadcrumb.astro";
import ShareButtons from "@/components/blog/ShareButtons.astro";
import TableOfContents from "@/components/blog/TableOfContents";
import { tagVariants } from "@/components/ui/tag";
import { calculateReadingTime, formatDate } from "@/lib/utils";

type Props = {
  post: CollectionEntry<"blog">;
};

const { post } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = calculateReadingTime(post.body ?? "");

/** トップ画像として書き出す幅（px） */
const TOP_IMAGE_WIDTHS = [400, 800, 1280];
/** 本文の列（md 以上で 12 列中 7 列）に合わせた画像の表示幅 */
const TOP_IMAGE_SIZES = "(min-width: 768px) 58vw, 100vw";
---

<div class="container mx-auto px-4 py-8 sm:px-10 md:py-12">
  <Breadcrumb
    items={[
      { name: "ホーム", url: "/" },
      { name: "ブログ", url: "/blog" },
      { name: post.data.title, url: `/blog/${post.id}` },
    ]}
  />
  <div class="grid grid-cols-12 gap-8">
    {/* SNS共有ボタン - PC左サイド */}
    <aside aria-label="記事の共有" class="hidden md:col-span-2 md:block">
      <div class="sticky top-20">
        <ShareButtons title={post.data.title} slug={post.id} />
      </div>
    </aside>

    {/* 記事コンテンツ */}
    <div class="col-span-12 md:col-span-7">
      <article class="prose prose-retro max-w-none prose-p:text-justify">
        {post.data.tags && post.data.tags.length > 0 && (
          <ul aria-label="タグ" class="not-prose mb-4 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <li>
                <a href={`/blog/${tag}`} class={tagVariants()}>
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )}

        <h1
          class="mb-3 text-3xl md:text-4xl"
          transition:name={`blog-title-${post.id}`}
        >
          {post.data.title}
        </h1>

        <div class="not-prose flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted-foreground">
          <div class="flex items-center gap-1.5">
            <Calendar className="size-6" aria-hidden="true" />
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
          </div>
          <div class="flex items-center gap-1.5">
            <Clock className="size-6" aria-hidden="true" />約{readingTime}
            分で読めます
          </div>
        </div>

        {post.data.topImage && (
          <figure transition:name={`blog-image-${post.id}`}>
            <Image
              class="mb-8 h-auto w-full"
              src={post.data.topImage}
              alt={post.data.title}
              width={1280}
              height={720}
              widths={TOP_IMAGE_WIDTHS}
              sizes={TOP_IMAGE_SIZES}
              priority
            />
          </figure>
        )}

        {/* モバイル用目次 */}
        <div class="mb-8 md:hidden">
          <TableOfContents client:load headings={headings} isMobile={true} />
        </div>

        {/* 記事本文 */}
        <div transition:animate="fade">
          <Content />
        </div>
      </article>

      <div class="not-prose my-12 flex items-center justify-center">
        <span class="h-1 w-full bg-border"></span>
      </div>

      <AuthorInfo />

      <div class="mt-8 border-2 border-border bg-card p-5 shadow-pixel-md md:hidden">
        <div class="flex flex-wrap items-center gap-4">
          <ShareButtons title={post.data.title} slug={post.id} />
        </div>
      </div>
    </div>
    {/* 目次 - PC右サイド */}
    <aside aria-label="目次" class="hidden md:col-span-3 md:block">
      <div class="h-full">
        <TableOfContents client:load headings={headings} />
      </div>
    </aside>
  </div>
</div>
